{
  "name": "orderfast-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "OrderFAST — University Campus Kiosk Ordering Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "npm --workspace=apps/api run db:generate",
    "db:migrate": "npm --workspace=apps/api run db:migrate"
  },
  "keywords": [
    "orderfast",
    "campus-ordering",
    "kiosk",
    "nextjs",
    "arabic",
    "rtl"
  ],
  "author": "OrderFAST Team",
  "license": "UNLICENSED"
}
