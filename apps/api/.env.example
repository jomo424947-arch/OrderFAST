# OrderFAST API Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL / Supabase connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret
JWT_SECRET=super-secret-jwt-key-orderfast

# CORS Allowed Origin (Supports '*', comma-separated URLs, or automatic *.vercel.app matching)
CORS_ORIGIN=http://localhost:3000

# Firebase Cloud Messaging (Optional for push notifications on Railway)
# Paste JSON string from service-account.json if using FCM notifications
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
