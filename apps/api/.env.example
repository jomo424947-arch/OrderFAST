# OrderFAST API Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL / Supabase connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase Credentials (REQUIRED in all environments - must be valid and >= 20 characters)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-min-20-chars
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-min-20-chars

# JWT Secret (REQUIRED in all environments - must be at least 32 characters long)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-minimum-32-characters-secure-jwt-secret-key-here

# CORS Allowed Origin (Supports '*', comma-separated URLs, or automatic *.vercel.app matching)
CORS_ORIGIN=http://localhost:3000

# Firebase Cloud Messaging (Optional for push notifications on Railway)
# Paste JSON string from service-account.json if using FCM notifications
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Akedly OTP Phone Verification (Required for Cash-on-Delivery student phone verification)
# Get your API Key and Pipeline ID from: https://app.akedly.io/pipelines
AKEDLY_API_KEY=your-akedly-api-key
AKEDLY_PIPELINE_ID=your-akedly-pipeline-id
